{
  "compilerOptions": {
    // то куда производится сборка
    "outDir": "./dist/",
    // Не позволяет использовать переменные без явного указания типа
    "noImplicitAny": true,
    "module": "ESNext",
    // указываем версию, в которую код будет компилироваться
    "target": "es5",
    "jsx": "react-jsx",
    // Для обсолютного импорта
    "baseUrl": ".",
    // говорит что все экспорты, импорты абсолютные будут идти из папки src
    "paths": {
      "*": ["./src/*"]
    },
    // позволяет компилятору обрабатывать не только ts файлы но и js
    "allowJs": true,
    "moduleResolution": "node",
    // Если какая либо библиотека не имеет дефолтный импорт
    // лоадеры вроде ts-loader или babel-loader создают их(не нужно будет прописывать * as)
    "allowSyntheticDefaultImports": true,
    // esModuleInterop позволяет работать с пакетами, которые используются
    // common js как с обычными пакетами с помощью import (require() module.export) = common js
    "esModuleInterop": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}